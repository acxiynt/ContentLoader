<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Genesis.ContentLoader</AssemblyName>
    <Product>Genesis.ContentLoader</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>7</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <Target Name="CopyRequiredAssemblies" AfterTargets="Build">
    <ItemGroup>
      <RequiredAssemblies Include="$(NuGetPackageRoot)mono.cecil\0.11.4\lib\netstandard2.0\Mono.Cecil.dll" />
      <RequiredAssemblies Include="$(NuGetPackageRoot)monomod.utils\22.5.1.1\lib\netstandard2.0\MonoMod.Utils.dll" />
      <RequiredAssemblies Include="$(NuGetPackageRoot)monomod.runtimedetour\22.5.1.1\lib\netstandard2.0\MonoMod.RuntimeDetour.dll" />
      <RequiredAssemblies Include="$(NuGetPackageRoot)nativelibraryloader\1.0.13\lib\netstandard2.0\NativeLibraryLoader.dll" />
    </ItemGroup>

    <Copy
      SourceFiles="@(RequiredAssemblies)"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
    <PackageReference Include="MonoMod.Utils" Version="22.5.1.1" />
    <PackageReference Include="NativeLibraryLoader" Version="1.0.13" />
    <PackageReference Include="MonoMod.RuntimeDetour" Version="22.5.1.1" />
    <Reference Include="Genesis.Core.dll">
      <HintPath>.\include\Genesis.Core.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp.dll">
      <HintPath>.\include\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass.dll">
      <HintPath>.\include\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule.dll">
      <HintPath>.\include\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule.dll">
      <HintPath>.\include\UnityEngine.AssetBundleModule.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
